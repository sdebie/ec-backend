# --------- [ ec-backend local environment ] ---------------------

# Database (defaults mirror application.properties)
# Named DEV_* rather than the literal QUARKUS_DATASOURCE_* names: Quarkus loads
# this file regardless of active profile, and QUARKUS_DATASOURCE_JDBC_URL would
# bind straight to the unprefixed quarkus.datasource.jdbc.url property, which a
# %test-scoped override in application.properties cannot outrank. Renaming it
# is what lets %test resolve to nothing and fall through to Dev Services.
DEV_QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:5432/ecommerce_db
DEV_QUARKUS_DATASOURCE_USERNAME=postgres
DEV_QUARKUS_DATASOURCE_PASSWORD=postgres
LOG_SQL=false

# CORS (prod-only: %prod.quarkus.http.cors.origins — ignored in dev/test) ──
# e.g. CORS_ORIGINS=https://www.uvhholdings.co.za
CORS_ORIGINS=

# PayFast (sandbox credentials)
PAYFAST_GATEWAY_URL=https://sandbox.payfast.co.za/eng/process
PAYFAST_MERCHANT_ID=10037872
PAYFAST_MERCHANT_KEY=jvyb485e4zpxq
PAYFAST_PASSPHRASE=testpayfast1

# Mailer (SMTP) configuration
# MAILER_MOCK: dev defaults to true (emails logged, not sent). Set false to
# exercise real SMTP delivery from dev. test is always mocked; prod always real
# unless MAILER_MOCK=true.
MAILER_MOCK=true
MAILER_FROM=shawn.debie@gmail.com
MAILER_HOST=smtp.gmail.com
MAILER_PORT=587
MAILER_USERNAME=shawn.debie@gmail.com
MAILER_PASSWORD=xzccqkoziherxyxb

# Rate limiting (contact enquiry)
ENQUIRY_RATE_LIMIT_MAX=5
ENQUIRY_RATE_LIMIT_WINDOW=3600

# Bootstrap admin (seeded on first boot when no staff exists)
ADMIN_BOOTSTRAP_EMAIL=admin@gmail.com
ADMIN_BOOTSTRAP_PASSWORD=Admin@123

# Storage (local dev/test only; prod uses S3)
IMAGE_STORAGE_PATH=/Users/shawndebie/Develop/storage/images
RESTCOUNTRIES_API_BASE_URL=https://api.restcountries.com/countries/v5
RESTCOUNTRIES_API_KEY=rc_live_47bdaa7c40634c36bca5f05b952e3e29
